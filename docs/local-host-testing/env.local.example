# Shape of the .env.local that docs/local-host-testing/setup.ps1 writes.
# The real values come from `supabase status` on the local stack; the keys in
# the API_URL/ANON_KEY placeholders below are the standard local ones.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local anon key from `supabase status`>

# Optional: patient attachments need a Cloudinary account.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_AUTHENTICATED=false
