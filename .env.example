VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# true -> signed uploads into Cloudinary's `authenticated` delivery type via the
# `cloudinary-sign` Edge Function (requires CLOUDINARY_API_KEY / _SECRET secrets
# on the Supabase project). false/absent -> classic unsigned preset uploads.
VITE_CLOUDINARY_AUTHENTICATED=

# Photos are downscaled to a 1600px long side and re-encoded in the browser
# before upload. Set to false only when the untouched original is required.
VITE_COMPRESS_ATTACHMENTS=
